{
  // Cloudflare project config. Read by both `wrangler` (deploy/dev) and the
  // Vitest workers pool (tests). One file, so tests run against the same
  // bindings production uses.
  "name": "personal-website",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],

  // This is a static site: the built output IS the repo root.
  "pages_build_output_dir": "."

  // ANALYTICS ACTIVATION (deferred on purpose — see runbook, ticket #10):
  // The /track Function writes to a D1 binding named `DB`. It is intentionally
  // NOT declared here yet, so deploys stay clean until the database exists.
  // Until then /track fails safe (no `DB` binding, nothing is stored).
  // To activate: run `npx wrangler d1 create analytics`, then add:
  //   "d1_databases": [
  //     { "binding": "DB", "database_name": "analytics", "database_id": "<id>" }
  //   ]
  // Tests do not use this block — the Vitest pool provides a local D1 (see
  // vitest.config.js).
}
