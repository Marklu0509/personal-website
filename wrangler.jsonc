{
  // Cloudflare Workers config (this project deploys via `npx wrangler deploy`,
  // i.e. Workers with Static Assets, NOT Pages).
  "name": "personal-website",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],

  // The Worker entry. It only handles dynamic routes (e.g. POST /track);
  // static files are served directly by the assets layer below.
  "main": "worker.js",

  // Serve the repo root as static assets. `.assetsignore` keeps source and
  // tooling files out of what gets published.
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  }

  // ANALYTICS ACTIVATION (deferred on purpose, see runbook #10):
  // /track writes to a D1 binding named `DB`, intentionally NOT declared yet
  // so deploys stay clean until the database exists. Until then /track fails
  // safe (no `DB` binding, nothing stored). To activate, run
  // `npx wrangler d1 create analytics`, then add:
  //   "d1_databases": [
  //     { "binding": "DB", "database_name": "analytics", "database_id": "<id>" }
  //   ]
}
